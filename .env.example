# Copy this file to .env and fill in optional configuration if you want to
# override defaults. All values here are OPTIONAL and safe to leave empty.
#
# IMPORTANT: .env is gitignored. Never commit it.

# Override the default local Solana keypair path.
# Defaults to ~/.config/solana/id.json
# Example: SOLANA_KEYPAIR_PATH=/home/me/.config/solana/id.json
SOLANA_KEYPAIR_PATH=

# Override the Solana RPC endpoint (defaults to Devnet).
# RPC_ENDPOINT=https://api.devnet.solana.com
RPC_ENDPOINT=
