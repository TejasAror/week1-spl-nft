{
  "name": "week1-spl-nft",
  "version": "1.0.0",
  "description": "Week 1 Solana assignment: SPL token mint/transfer + Metaplex MPL Core NFT on Devnet",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "mint:token": "tsx src/index.ts token",
    "transfer:token": "tsx src/index.ts transfer",
    "mint:nft": "tsx src/index.ts nft",
    "update:nft": "tsx src/index.ts update",
    "demo": "tsx src/index.ts all",
    "test": "vitest run tests/config.test.ts",
    "test:all": "vitest run",
    "test:unit": "vitest run tests/config.test.ts",
    "test:integration": "vitest run tests/spl.test.ts tests/nft.test.ts",
    "reset": "tsx src/reset.ts"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-core": "^1.10.0",
    "@metaplex-foundation/umi": "^1.5.1",
    "@metaplex-foundation/umi-bundle-defaults": "^1.5.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
